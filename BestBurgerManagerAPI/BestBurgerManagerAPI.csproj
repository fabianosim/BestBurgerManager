<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <Copyright>Best Burger Manager API v1.0.0</Copyright>
    <Description>An API to manage the routing of Point of Sales orders.</Description>
    <PackageLicenseUrl>https://opensource.org/licenses/GPL-3.0</PackageLicenseUrl>
    <StartupObject>BestBurgerManagerAPI.Program</StartupObject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DocumentationFile>C:\Users\fabia\Projetos\RDI\BestBurgerManager\BestBurgerManagerAPI\BestBurgerManagerAPI.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.AspNetCore.App is provided by the shared framework in newer TFMs; remove explicit package reference -->
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="9.0.12" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BestBurgerManager.Business\BestBurgerManager.Business.csproj" />
    <ProjectReference Include="..\BestBurgerManager.Entities\BestBurgerManager.Entities.csproj" />
    <ProjectReference Include="..\BestBurgerManager.Interfaces\BestBurgerManager.Interfaces.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Data\apiusers.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Update="BestBurgerManagerAPI.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="CHANGELOG.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="README.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
